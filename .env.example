# Copia este archivo a .env y completa los valores. .env NO se versiona.

# Token del bot de Telegram (lo da @BotFather al crear el bot).
TELEGRAM_TOKEN=

# Cerebro de Espartaco: API directa de DeepSeek (endpoint OpenAI-compatible
# https://api.deepseek.com). Si la key se queda sin saldo, el bot deja de
# responder hasta que se recargue.
DEEPSEEK_API_KEY=
# Modelo principal (cerebro + lectura de fotos). Tiene que aceptar imagen.
DEEPSEEK_MODEL=deepseek-flash
# Opcional: modelo de respaldo si el principal falla o se cuelga.
# DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

# ID numerico del grupo de Telegram autorizado (ej. -1001234567890).
# OBLIGATORIO para que el bot responda: sin esto no contesta en ningun chat.
# Para averiguarlo, arranca el bot, escribe /start en el grupo y copia el
# chat_id que aparece en el log ("Chat no autorizado (chat_id=...)").
ALLOWED_CHAT_ID=

# Calendario de Google Calendar donde Espartaco crea/consulta eventos.
CALENDAR_ID=primary

# ID de una lista de Google Tasks dedicada a Espartaco (creala aparte para no
# mezclarla con tus tareas personales). Sin esto, las herramientas de tareas
# avisan que falta configurar.
TASKLIST_ID=

# ID de la Google Sheet de finanzas (parte de la URL entre /d/ y /edit) y
# nombres de sus pestanas. Ver README.md para las columnas de cada una.
FINANCE_SHEET_ID=
FINANCE_SHEET_TAB=Sheet1
PAGOS_RECURRENTES_TAB=Pagos Recurrentes
MEDICAMENTOS_TAB=Medicamentos
HABITOS_TAB=Habitos
NOTAS_TAB=Notas
INICIATIVAS_TAB=Iniciativas

# API key de Serper.dev (https://serper.dev) para buscar en internet (precios,
# negocios locales). Sin esto, esas herramientas avisan que falta configurar.
SERPER_API_KEY=
# Opcional: ciudad/zona por defecto para buscar negocios locales.
SERPER_UBICACION_DEFAULT=Bogotá, Colombia

# Opcional: proyecto de Apps Script vinculado a la hoja (solo lo usa
# subir_apps_script.sh). Editor de Apps Script -> Configuracion del proyecto -> ID.
APPS_SCRIPT_ID=

# --- Contenedor (VM en la nube) ---
# Estas NO van en .env: se pasan al contenedor con `docker run -e` (main.py
# lee DATA_DIR y LOG_TO_FILE antes de cargar .env). En el PC se dejan sin
# definir y todo queda como siempre (carpeta del proyecto, logs/ y token.json).
# DATA_DIR=/data                               # historial, estado_jobs, latido
# GOOGLE_TOKEN_PATH=/data/token.json           # escribible: cada refresh se guarda
# CONTEXTO_FAMILIA_PATH=/data/contexto_familia.md
# LOG_TO_FILE=0                                # solo stdout (docker logs)
