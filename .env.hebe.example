# Configuración del puente HEBE Agents <-> Espartaco (hebe_webhook.py).
# Copia este archivo como .env.hebe (no se versiona) y completa los valores.

# Carpeta con la instalación configurada de Espartaco (.env, token.json, venv).
# Vacío = esta misma carpeta. Usa barras normales: C:/Users/...
SPARTACO_DIR=

# Clave que HEBE manda en "Authorization: Bearer <valor>". En HEBE va en
# .env.local como SPARTACO_API_KEY=Bearer <valor>.
HEBE_AGENT_TOKEN=

# Mismo valor que AGENTS_WEBHOOK_SECRET en el .env.local de HEBE: firma los resultados.
HEBE_WEBHOOK_SECRET=

# Orígenes de HEBE a los que se permite entregar resultados (separados por coma).
HEBE_CALLBACK_ORIGINS=http://localhost:3000

HEBE_PORT=8787
